{% assign sorted_projects = site.projects | sort: "importance" %}
{% for project in sorted_projects %}
<div class="row" style="margin-top: 2rem;">
  <div class="col-sm-10" style="line-height: 1.5;">
    <style>
      .selected-project p { margin-bottom: 0.1rem; }
      .selected-project ul { margin-top: 0.25rem; }
    </style>
    <div class="selected-project">
      {{ project.content }}
    </div>
  </div>
</div>
{% endfor %}
